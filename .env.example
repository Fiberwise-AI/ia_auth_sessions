# Database
DATABASE_URL=postgresql://localhost/myapp

# Auth Configuration
AUTH_SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long
AUTH_SESSION_COOKIE_NAME=session
AUTH_SESSION_MAX_AGE=604800  # 7 days in seconds
AUTH_COOKIE_SECURE=false  # Set to true in production (HTTPS only)
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SAMESITE=lax
